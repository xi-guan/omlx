<?xml version="1.0" encoding="UTF-8"?>
<!--
  LaunchAgent template for running oMLX as a persistent server.

  Do not edit this file's paths by hand. `just service-install`
  substitutes the __HOME__ / __PROJECT__ / __UV__ placeholders for the
  target machine and installs the result to
  ~/Library/LaunchAgents/ai.omlx.server.plist.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.omlx.server</string>

    <!-- bind all interfaces so other machines on the LAN can reach it;
         port still resolved from ~/.omlx/settings.json -->
    <key>ProgramArguments</key>
    <array>
        <string>__UV__</string>
        <string>run</string>
        <string>omlx</string>
        <string>serve</string>
        <string>--host</string>
        <string>0.0.0.0</string>
    </array>

    <!-- run from the repo so `uv run` resolves the project venv -->
    <key>WorkingDirectory</key>
    <string>__PROJECT__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <!-- start at login, restart on crash -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__HOME__/.omlx/logs/server.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.omlx/logs/server.err.log</string>
</dict>
</plist>
